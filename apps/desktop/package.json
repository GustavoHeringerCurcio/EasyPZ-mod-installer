    "@fontsource-variable/space-grotesk": "^5.1.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
